# From the spec's "Declarations and assignment".
/IP(dst=1.2.3.4)/UDP(src=1,dst=2) {
  num_resp = 0
  catch { # quit this block on the first timeout
    repeat count=10 {
      Bytes("Ping\n")
      expect timeout=1s Bytes("Pong\n") {
        num_resp += 1
      }
    }
  }
  print("Got ${num_resp} repsonses")
}
